{
  "name": "hivehook/sdk",
  "description": "Official PHP client for Hivehook, webhook infrastructure for modern teams (inbound and outbound).",
  "type": "library",
  "license": "MIT",
  "keywords": ["hivehook", "webhook", "webhooks", "graphql", "sdk"],
  "homepage": "https://hivehook.com",
  "support": {
    "issues": "https://github.com/hivehook/sdk-php/issues",
    "source": "https://github.com/hivehook/sdk-php",
    "docs":   "https://hivehook.com/docs"
  },
  "authors": [
    {"name": "Hivehook", "homepage": "https://hivehook.com"}
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Hivehook\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hivehook\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
